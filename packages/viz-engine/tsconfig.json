{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/index.ts",
    "src/draw.ts",
    "src/acts.ts",
    "src/narrator.ts",
    "src/engine/**/*.ts",
    "src/engine/**/*.tsx"
  ],
  "exclude": ["src/engine/storybook/**"]
}
