{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "viz-engine",
  "projectType": "library",
  "sourceRoot": "packages/viz-engine/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build -c packages/viz-engine/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/viz-engine/tsconfig.json --noEmit"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm publish --workspace @brett_lamy/viz-engine --access public"
      }
    }
  }
}
