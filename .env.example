# --- Frontend (Vite) ---
VITE_AUTH0_DOMAIN=webreplay.us.auth0.com
VITE_AUTH0_CLIENT_ID=
# Optional: set to get a JWT access token instead of an opaque one
VITE_AUTH0_AUDIENCE=

# --- Netlify Functions ---
AUTH0_DOMAIN=webreplay.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_ENSURE_USER_FOR_AUTH_SECRET=

# A hardcoded JWT accepted verbatim as the Bearer token (skips JWKS verification)
AUTH_BYPASS_JWT=

# An Auth0 refresh token for the GitHub Token Vault exchange under bypass
AUTH_BYPASS_REFRESH_TOKEN=

# --- Emulated local stack (set by scripts/dev-stack.mjs) ---
# Point the API clients at the BLamy/emulate emulators instead of real services.
#AUTH0_BASE_URL=http://127.0.0.1:4301
#AUTH0_REALM=Username-Password-Authentication
#GITHUB_API_URL=http://127.0.0.1:4300
#STRIPE_API_URL=http://127.0.0.1:4302
#VITE_AUTH0_PASSWORD_LOGIN=true

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=price_blamy_pro
STRIPE_WEBHOOK_SECRET=
